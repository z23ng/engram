# ==============================================================================
# AI Memory (`mem`) Runtime Configuration
# ==============================================================================
# Copy to ~/.ai-memory/mem.env (or run ./scripts/deploy.sh to generate automatically)

# Single-file embedded SQLite WAL database path
MEM_DB_PATH=~/.ai-memory/memory.db

# ------------------------------------------------------------------------------
# Option A: Local Development with Ollama (Default, 100% Offline & Free)
# ------------------------------------------------------------------------------
MEM_PROVIDER=ollama
MEM_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
MEM_EMBEDDING_MODEL=bge-m3
MEM_EMBEDDING_DIMENSIONS=1024
MEM_LLM_BASE_URL=http://127.0.0.1:11434/v1
MEM_LLM_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# Option B: Production with OpenAI API (Uncomment to switch to production)
# ------------------------------------------------------------------------------
# MEM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# MEM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# MEM_EMBEDDING_MODEL=text-embedding-3-small
# MEM_EMBEDDING_DIMENSIONS=1536
# MEM_LLM_BASE_URL=https://api.openai.com/v1
# MEM_LLM_MODEL=gpt-6-luna

# ------------------------------------------------------------------------------
# Option C: Lite Zero-Model CPU Mode (Pure SQLite FTS5 BM25 + Obsidian Wiki Graph)
# ------------------------------------------------------------------------------
# MEM_PROVIDER=disabled
